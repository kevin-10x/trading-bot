# Production Environment Variables
# Copy this file to create your production environment configuration
# Set these in Vercel Project Settings → Environment Variables

# Core Application
NODE_ENV=production
PORT=3000

# Database (PlanetScale)
# Get from: https://planetscale.com → Your Database → Connect
DATABASE_URL=mysql://username:password@host/trading_bot

# Cache (Upstash Redis)
# Get from: https://upstash.com → Your Database → Details
REDIS_URL=redis://default:password@host:port

# Authentication & Security
# Generate strong random values for production
JWT_SECRET=generate-strong-random-key-min-32-chars-recommended
APP_ID=your-app-id
APP_SECRET=your-app-secret-keep-this-secure

# KIMI Integration (if using)
KIMI_AUTH_URL=https://your-kimi-auth-endpoint
KIMI_OPEN_URL=https://your-kimi-open-endpoint
OWNER_UNION_ID=your-owner-union-id-optional

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# Telegram Bot Integration (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather

# Alpha Vantage API (optional - for stock/forex data)
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key

# MT5 Webhook Configuration
# Generate strong random secret for webhook validation
MT5_WEBHOOK_SECRET=generate-strong-random-secret

# AWS S3 Configuration (optional - for file uploads)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1

# Error Tracking (optional - Sentry)
SENTRY_DSN=your-sentry-dsn-url

# Analytics (optional)
ANALYTICS_KEY=your-analytics-key
